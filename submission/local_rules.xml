<!--
  Meridian SOC — Wazuh local rules (final / Challenge-tuned).
  Deployed on MERIDIAN-SOC01 as /var/ossec/etc/rules/local_rules.xml
  Parent for 100020 is built-in 5760 (Wazuh 4.14 journald sshd auth-fail).
-->

<group name="meridian,kerberoasting,attack,">
  <rule id="100010" level="10">
    <if_group>windows_security</if_group>
    <field name="win.system.eventID">^4769$</field>
    <field name="win.eventdata.ticketEncryptionType">^0x17$</field>
    <description>Kerberos TGS request using RC4 encryption</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
    <group>kerberoasting,attack_credential_access,</group>
  </rule>
  <rule id="100011" level="12" frequency="8" timeframe="300">
    <if_matched_sid>100010</if_matched_sid>
    <same_source_ip />
    <description>Possible Kerberoasting: 8+ RC4 TGS requests from one source in 5 minutes</description>
    <mitre>
      <id>T1558.003</id>
    </mitre>
  </rule>
</group>

<group name="meridian,ssh_bruteforce,attack,">
  <rule id="100020" level="10" frequency="5" timeframe="120">
    <if_matched_sid>5760</if_matched_sid>
    <same_source_ip />
    <same_field>dstuser</same_field>
    <description>Meridian: 5+ SSH failures, same source and same username, in 2 minutes</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>ssh_bruteforce,attack_credential_access,</group>
  </rule>
</group>
